---
/** Estructura común de todas las páginas: <head>, fuentes, fondo, header y footer. */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Prompt from '../components/Prompt.astro';

interface Props {
  title?: string;
  description?: string;
  /** Contenedor más ancho (páginas de cheatsheet, que tienen 3 columnas) */
  wide?: boolean;
}

const {
  title,
  wide = false,
  description = 'Cheatsheets personales de Backend, Frontend y Hardware para repasar mientras aprendo a programar.',
} = Astro.props;

const container = wide ? 'max-w-[96rem]' : 'max-w-7xl';
const fullTitle = title ? `${title} · joaco://cheatsheets` : 'joaco://cheatsheets';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f0a1a" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@500;700&family=Space+Mono:wght@400;700&display=swap"
    />
    <title>{fullTitle}</title>
  </head>
  <body class="flex flex-col">
    <div class="backdrop" aria-hidden="true"></div>

    <a
      href="#contenido"
      class="sr-only z-50 rounded-md bg-accent px-3 py-2 font-ui text-sm text-bg focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Saltar al contenido
    </a>

    <Header container={container} />

    <main
      id="contenido"
      class:list={['mx-auto w-full flex-1 px-4 py-8 sm:px-6 sm:py-12', container]}
    >
      <slot />
    </main>

    <footer class="border-t border-line/60">
      <div
        class:list={[
          'mx-auto flex flex-col gap-2 px-4 py-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6',
          container,
        ]}
      >
        <Prompt command="exit" class="text-xs" />
        <p class="font-ui">
          Inspirado en{' '}
          <a
            href="https://github.com/nachovigilante/cheatsheets"
            target="_blank"
            rel="noopener noreferrer"
            class="underline decoration-line underline-offset-4 hover:text-fg"
          >
            TIC Cheatsheets
          </a>
        </p>
      </div>
    </footer>
  </body>
</html>
