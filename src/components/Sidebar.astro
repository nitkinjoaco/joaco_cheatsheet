---
/** Explorador de archivos: una carpeta por categoría con sus cheatsheets adentro. */
import { CATEGORY_IDS, accentStyle, type CategoryId } from '../lib/categories';
import { getCheatsheetsByCategory, getFileName, getHref } from '../lib/cheatsheets';

interface Props {
  currentCategory?: CategoryId;
  currentHref?: string;
}

const { currentCategory, currentHref } = Astro.props;
const grouped = await getCheatsheetsByCategory();
---

<nav aria-label="Cheatsheets" class="no-ligatures font-ui text-sm">
  <p class="mb-3 px-2 text-xs tracking-widest text-muted uppercase">Explorador</p>
  <ul class="space-y-1">
    {CATEGORY_IDS.map((id) => (
      <li style={accentStyle(id)}>
        <details class="tree" open={id === currentCategory}>
          <summary class="flex cursor-pointer items-center gap-2 rounded-md px-2 py-1 hover:bg-white/5">
            <span class="tree-arrow text-xs text-muted" aria-hidden="true">
              ▸
            </span>
            <span class="text-(--accent)">{id}/</span>
            <span class="ml-auto text-xs text-muted">{grouped[id].length}</span>
          </summary>
          <ul class="mt-1 ml-3.5 border-l border-line pl-2">
            {grouped[id].length === 0 ? (
              <li class="px-2 py-1 text-muted italic">(vacío)</li>
            ) : (
              grouped[id].map((entry) => {
                const href = getHref(entry);
                const active = href === currentHref;
                return (
                  <li>
                    <a
                      href={href}
                      aria-current={active ? 'page' : undefined}
                      class:list={[
                        'block truncate rounded-md px-2 py-1 transition-colors',
                        active ? 'tint text-fg' : 'text-muted hover:bg-white/5 hover:text-fg',
                      ]}
                    >
                      {getFileName(entry)}
                    </a>
                  </li>
                );
              })
            )}
            <li>
              <a
                href={`/${id}`}
                class="block rounded-md px-2 py-1 text-xs text-muted/70 transition-colors hover:text-(--accent)"
              >
                ls {id}/ →
              </a>
            </li>
          </ul>
        </details>
      </li>
    ))}
  </ul>
</nav>
