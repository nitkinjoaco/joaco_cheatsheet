---
/**
 * Línea de prompt tipo bash: joaco@cheatsheets ~/backend git:(main) $ comando
 * El comando se pasa con `command`, o como contenido si necesita HTML adentro.
 * Los {' '} del template son espacios explícitos: Astro compacta el HTML y sin ellos
 * quedaría todo pegado ("joaco@cheatsheets~git:(main)$").
 */
interface Props {
  path?: string;
  command?: string;
  cursor?: boolean;
  class?: string;
}

const { path = '~', command, cursor = false, class: className } = Astro.props;
---

<p class:list={['no-ligatures font-mono text-sm leading-relaxed break-words', className]}>
  <span class="text-muted">joaco@cheatsheets</span> <span class="text-prompt-path">{path}</span>{' '}
  <span class="text-prompt-git">
    git:<span class="text-prompt-branch">(main)</span>
  </span>{' '}
  <span class="text-muted">$</span>{' '}
  {Astro.slots.has('default') ? (
    <span class="text-fg">
      <slot />
    </span>
  ) : (
    command && <span class="text-fg">{command}</span>
  )}
  {cursor && <span class="cursor text-fg" aria-hidden="true"></span>}
</p>
