---
import { CATEGORIES, CATEGORY_IDS, accentStyle } from '../lib/categories';

interface Props {
  container?: string;
}

const { container = 'max-w-7xl' } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '');
---

<header class="sticky top-0 z-40 border-b border-line/60 bg-bg/70 backdrop-blur-md">
  <div class:list={['mx-auto flex h-14 items-center gap-4 px-4 sm:px-6', container]}>
    <a href="/" class="no-ligatures flex items-center gap-2.5 font-ui text-sm font-bold">
      <span
        class="grid size-8 place-items-center rounded-md border border-accent/40 bg-accent/10 text-accent"
        aria-hidden="true"
      >
        &gt;_
      </span>
      <span>
        <span class="text-accent">joaco</span>
        <span class="text-muted">://</span>cheatsheets
      </span>
    </a>

    <nav aria-label="Categorías" class="ml-auto flex items-center gap-1 font-ui text-sm">
      {CATEGORY_IDS.map((id) => {
        const active = pathname === `/${id}` || pathname.startsWith(`/${id}/`);
        return (
          <a
            href={`/${id}`}
            style={accentStyle(id)}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'hidden items-center gap-2 rounded-md px-3 py-1.5 transition-colors sm:flex',
              active ? 'tint text-fg' : 'text-muted hover:bg-white/5 hover:text-fg',
            ]}
          >
            <span class="size-2 rounded-full bg-(--accent)" aria-hidden="true" />
            {CATEGORIES[id].label}
          </a>
        );
      })}
      <a
        href="https://github.com/nitkinjoaco/joaco_cheatsheet"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Repositorio en GitHub"
        class="ml-1 grid size-9 place-items-center rounded-md text-muted transition-colors hover:bg-white/5 hover:text-fg"
      >
        <svg viewBox="0 0 16 16" class="size-5" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
        </svg>
      </a>
    </nav>
  </div>
</header>
