---
/** Índice automático armado con los títulos (## y ###) del cheatsheet. */
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length > 0 && (
  <nav aria-label="En esta página" class="font-ui text-sm">
    <p class="mb-3 text-xs tracking-widest text-muted uppercase">En esta página</p>
    <ul class="space-y-1 border-l border-line">
      {items.map((h) => (
        <li>
          <a
            href={`#${h.slug}`}
            class:list={[
              '-ml-px block border-l border-transparent py-0.5 text-muted transition-colors hover:border-(--accent) hover:text-fg',
              h.depth === 3 ? 'pl-6 text-xs' : 'pl-3',
            ]}
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
