---
/** Tarjeta de la landing: una ventana por categoría con un adelanto de sus archivos. */
import TerminalWindow from './TerminalWindow.astro';
import { CATEGORIES, accentStyle, type CategoryId } from '../lib/categories';
import { getFileName, type Cheatsheet } from '../lib/cheatsheets';

interface Props {
  id: CategoryId;
  entries: Cheatsheet[];
}

const { id, entries } = Astro.props;
const category = CATEGORIES[id];
const preview = entries.slice(0, 4);
const hidden = entries.length - preview.length;
---

<TerminalWindow
  title={`~/${id}/`}
  href={`/${id}`}
  style={accentStyle(id)}
  class="group flex h-full flex-col transition duration-200 hover:-translate-y-1 hover:border-(--accent)/60 focus-visible:-translate-y-1"
>
  <div class="flex flex-1 flex-col gap-5 p-5 sm:p-6">
    <div>
      <p class="no-ligatures font-ui text-xs text-(--accent)">{category.topics}</p>
      <h3 class="mt-2 font-display text-3xl font-bold">{category.label}</h3>
      <p class="mt-2 text-sm text-muted">{category.description}</p>
    </div>

    <ul class="card space-y-1 p-3 text-sm">
      {preview.length === 0 ? (
        <li class="text-muted italic">total 0 · próximamente</li>
      ) : (
        preview.map((entry) => (
          <li class="flex items-center gap-2 truncate">
            <span class="text-(--accent)" aria-hidden="true">
              ›
            </span>
            {getFileName(entry)}
          </li>
        ))
      )}
      {hidden > 0 && <li class="text-muted">… y {hidden} más</li>}
    </ul>

    <p class="mt-auto flex items-center justify-between border-t border-line pt-4 font-ui text-xs text-muted">
      <span>
        {entries.length} {entries.length === 1 ? 'cheatsheet' : 'cheatsheets'}
      </span>
      <span class="text-(--accent) transition-transform group-hover:translate-x-1">cd {id} →</span>
    </p>
  </div>
</TerminalWindow>
