---
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import Prompt from '../components/Prompt.astro';
import CategoryCard from '../components/CategoryCard.astro';
import { CATEGORY_IDS, accentStyle, type CategoryId } from '../lib/categories';
import { getCheatsheetsByCategory, getFileName } from '../lib/cheatsheets';

const grouped = await getCheatsheetsByCategory();
const total = CATEGORY_IDS.reduce((sum, id) => sum + grouped[id].length, 0);

// Líneas del comando `tree` que se muestra en el hero, armadas con el contenido real
type TreeLine = { prefix: string; text: string; category?: CategoryId; folder?: boolean };
const treeLines: TreeLine[] = CATEGORY_IDS.flatMap((id, i) => {
  const last = i === CATEGORY_IDS.length - 1;
  const indent = last ? '    ' : '│   ';
  const files = grouped[id];
  const children: TreeLine[] =
    files.length === 0
      ? [{ prefix: `${indent}└── `, text: '(vacío)', category: id }]
      : files.map((entry, j) => ({
          prefix: `${indent}${j === files.length - 1 ? '└── ' : '├── '}`,
          text: getFileName(entry),
          category: id,
        }));
  return [
    { prefix: last ? '└── ' : '├── ', text: `${id}/`, category: id, folder: true },
    ...children,
  ];
});
---

<BaseLayout>
  <!-- Hero -->
  <section class="grid items-center gap-10 py-6 sm:py-12 lg:grid-cols-[minmax(0,1fr)_26rem]">
    <div>
      <Prompt command="whoami" />
      <h1 class="no-ligatures mt-6 font-display text-5xl leading-[0.95] font-bold tracking-tight sm:text-7xl xl:text-8xl">
        <span class="block text-muted/70">joaco://</span>
        <span class="block">
          cheatsheets<span class="cursor text-accent"></span>
        </span>
      </h1>
      <p class="mt-6 max-w-xl text-base text-muted sm:text-lg">
        Mis machetes para repasar mientras aprendo a programar: comandos, sintaxis y ejemplos listos
        para copiar.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3 font-ui text-sm">
        <a
          href="#categorias"
          class="no-ligatures rounded-md border border-accent/50 bg-accent/10 px-4 py-2 transition-colors hover:bg-accent/20"
        >
          &gt; ls categorías
        </a>
        <span class="text-muted">
          {total} cheatsheets · {CATEGORY_IDS.length} categorías
        </span>
      </div>
    </div>

    <!-- Árbol de archivos real, generado con el contenido -->
    <TerminalWindow title="joaco@cheatsheets: ~" class="hidden sm:block">
      <div class="no-ligatures space-y-3 p-5 text-sm leading-relaxed">
        <Prompt command="tree" />
        <div class="font-mono" role="img" aria-label="Árbol de carpetas y archivos">
          <span class="block text-muted">.</span>
          {treeLines.map((line) => (
            <span
              class="flex whitespace-pre"
              style={line.category ? accentStyle(line.category) : undefined}
            >
              <span class="text-muted">{line.prefix}</span>
              <span class={line.folder ? 'text-(--accent)' : 'text-fg'}>{line.text}</span>
            </span>
          ))}
          <span class="mt-2 block text-muted">
            {CATEGORY_IDS.length} directories, {total} files
          </span>
        </div>
        <Prompt cursor />
      </div>
    </TerminalWindow>
  </section>

  <!-- Categorías -->
  <section id="categorias" class="scroll-mt-20 py-8">
    <Prompt command="ls -d */" />
    <div class="mt-6 grid gap-5 md:grid-cols-3">
      {CATEGORY_IDS.map((id) => (
        <CategoryCard id={id} entries={grouped[id]} />
      ))}
    </div>
  </section>
</BaseLayout>
