---
/** /backend, /frontend, /hardware: lista de cheatsheets de la categoría. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import TerminalWindow from '../../components/TerminalWindow.astro';
import Prompt from '../../components/Prompt.astro';
import CheatsheetCard from '../../components/CheatsheetCard.astro';
import { CATEGORIES, CATEGORY_IDS, accentStyle, type CategoryId } from '../../lib/categories';
import { getCheatsheetsByCategory } from '../../lib/cheatsheets';

export function getStaticPaths() {
  return CATEGORY_IDS.map((category) => ({ params: { category }, props: { category } }));
}

interface Props {
  category: CategoryId;
}

const { category } = Astro.props;
const { label, description, topics } = CATEGORIES[category];
const entries = (await getCheatsheetsByCategory())[category];
---

<BaseLayout title={label} description={description}>
  <TerminalWindow title={`joaco://cheatsheets/${category}/`} style={accentStyle(category)}>
    <div class="p-5 sm:p-8 lg:p-10">
      <Prompt path={`~/${category}`} command="ls -la" />

      <header class="mt-6">
        <p class="no-ligatures font-ui text-xs tracking-widest text-(--accent) uppercase">
          {topics}
        </p>
        <h1 class="mt-2 font-display text-4xl font-bold sm:text-6xl">{label}</h1>
        <p class="mt-3 max-w-2xl text-muted">{description}</p>
        <p class="mt-4 font-ui text-xs text-muted">total {entries.length}</p>
      </header>

      {entries.length > 0 ? (
        <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {entries.map((entry) => (
            <li>
              <CheatsheetCard entry={entry} />
            </li>
          ))}
        </ul>
      ) : (
        <div class="card mt-8 border-dashed p-8 text-center text-sm">
          <p class="text-muted">ls: todavía no hay cheatsheets en {category}/</p>
          <p class="no-ligatures mt-2 font-ui text-xs text-muted/70">
            Creá src/content/cheatsheets/{category}/nombre.md
          </p>
        </div>
      )}

      <a href="/" class="group mt-10 inline-block">
        <Prompt path={`~/${category}`} command="cd ~" class="group-hover:opacity-80" />
      </a>
    </div>
  </TerminalWindow>
</BaseLayout>
